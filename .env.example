# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Voyage AI (KB document embeddings + RAG retrieval)
VOYAGE_API_KEY=

# Inngest — required for message processing and KB ingest (Manage → Event keys / Signing keys):
# - Event key: used by EventBus → inngest.send() → POST https://inn.gs/e/<key>
# - Signing key: used by Inngest to call /api/inngest (starts with signkey-prod-)
# Local dev: run `npm run dev:inngest` (terminal 1) + `npm run inngest:dev` (terminal 2)
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Security — must be exactly 64 hex chars (generate: openssl rand -hex 32)
ENCRYPTION_KEY=
ADMIN_SECRET=a-secret-for-admin-api-at-least-16-chars

# Cal.com (optional — per-org credentials are stored in DB, this is only for overriding the base URL in tests)
CAL_COM_API_BASE_URL=https://api.cal.com

# Stripe — platform account (Inboxy billing + Connected Accounts for orgs)
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Webhook secrets — create via Stripe Dashboard → Webhooks
STRIPE_WEBHOOK_SECRET=whsec_...            # platform billing events (subscriptions, invoices)
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_...    # connect events (checkout.session.completed, account.updated)
# Platform fee charged on every B2C sale (percent, e.g. "10" = 10%)
STRIPE_PLATFORM_FEE_PERCENT=10
# Stripe Price IDs for Inboxy subscription plans (from Stripe Dashboard → Products)
# Test mode (Braxen test account — acct_1Tdt3BINWsXvD6se):
STRIPE_PRICE_ID_STARTER=price_1UG3CfINWsXvD6sexi1u5UZ1
STRIPE_PRICE_ID_PROFESSIONAL=price_1UG3CtINWsXvD6sewKkwgwrF
STRIPE_PRICE_ID_BUSINESS=price_1UG3DAINWsXvD6seM6bKUg1D

# PostHog — project 307577 (TFAR org)
NEXT_PUBLIC_POSTHOG_KEY=phc_bFkl100ZAxIJBAKJVYAWoSyrAFQHbwv7EWKe4LCLNQZ
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Server-side analytics (store analytics API route)
# Create at: PostHog → Settings → Personal API Keys (scope: project:read)
POSTHOG_PERSONAL_API_KEY=phx_...
POSTHOG_PROJECT_ID=307577
# Labels prod vs staging in logs, traces, and analytics (set per Vercel environment)
# production | staging | development | preview
NEXT_PUBLIC_DEPLOYMENT_ENV=development
DEPLOYMENT_ENV=development

# App URL — auth email redirects, webhooks, etc.
# Local: http://localhost:3000 | Production: https://inboxy.braxentech.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Pilot mode — free access with Business plan (stripe_subscription_id=pilot in DB)
# Set to true during pilot; remove or set false to force Stripe checkout
# INBOXY_PILOT_MODE=true

# Braxen contact (WhatsApp CTA on marketing pages; default matches braxen-web)
# NEXT_PUBLIC_BRAXEN_WHATSAPP_NUMBER=5521973118404
